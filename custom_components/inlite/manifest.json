{
    "domain": "inlite",
    "name": "in-lite Outdoor Lighting",
    "bluetooth": [
        {
            "local_name": "inlitebt",
            "connectable": true
        }
    ],
    "codeowners": ["@bbruenings"],
    "config_flow": true,
    "dependencies": ["bluetooth"],
    "documentation": "https://github.com/bbruenings/ha-inlite",
