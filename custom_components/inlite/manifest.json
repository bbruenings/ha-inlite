    "iot_class": "local_polling",
    "issue_tracker": "https://github.com/bbruenings/ha-inlite/issues",
    "requirements": [
        "pycryptodomex>=3.20.0"
    ],
    "version": "0.2.1",
    "brand": {
        "logo": "brand/logo.png",
        "icon": "brand/icon.png"
    }
}
